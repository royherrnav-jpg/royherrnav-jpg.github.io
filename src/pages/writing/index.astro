---
import Base from '../../layouts/Base.astro';
import WritingList from '../../components/WritingList.astro';
import WritingNav from '../../components/WritingNav.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('writing', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);
---

<Base title="Writing" description="Essays, thoughts and poems.">
  <header class="page-head">
    <h1>Writing</h1>
    <p class="lede">Essays, thoughts and poems. Also available as an <a href="/rss.xml">RSS feed</a>.</p>
  </header>

  <WritingNav posts={posts} />

  {posts.length === 0 ? <p class="empty">Nothing here yet.</p> : <WritingList posts={posts} showKind />}
</Base>

---
import Base from '../layouts/Base.astro';
import Wigner from '../components/Wigner.astro';
import PostList from '../components/PostList.astro';
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import { frontmatter as research } from '../research.md';
import { SITE } from '../site.config';

const byNewest = (a: { data: { date: Date } }, b: { data: { date: Date } }) =>
  b.data.date.valueOf() - a.data.date.valueOf();

const posts = (await getCollection('writing', ({ data }) => !data.draft)).sort(byNewest);
const [latestAlbum] = (await getCollection('albums')).sort(byNewest);
const links = SITE.links.filter((link) => link.href);
---

<Base home>
  <section class="home-top">
    <div>
      <h1 class="home-name">{SITE.name}</h1>
      <p class="home-bio">{SITE.bio}</p>
      {
        links.length > 0 && (
          <ul class="inline-links">
            {links.map((link) => (
              <li>
                <a href={link.href}>{link.label}</a>
              </li>
            ))}
          </ul>
        )
      }
    </div>
    <Wigner alpha={2}>
      W(x, p) for a cat state of light, α = 2. The <em>negative regions</em> have no classical counterpart.
    </Wigner>
  </section>

  <section class="home-cols">
    <div>
      <h2 class="label"><a href="/research/">Research</a></h2>
      <a href="/research/">{research.role}</a>
      <p class="summary">{research.summary}</p>
      <span class="status">{research.areas.join(' · ').toLowerCase()}</span>
    </div>

    <div>
      <h2 class="label"><a href="/writing/">Writing</a></h2>
      <PostList posts={posts.slice(0, 4)} />
    </div>

    <div>
      <h2 class="label"><a href="/photographs/">Photographs</a></h2>
      {
        latestAlbum ? (
          <>
            <a class="thumbs" href={`/photographs/${latestAlbum.id}/`}>
              {latestAlbum.data.photos.slice(0, 4).map((photo) => (
                <Image src={photo.src} alt="" widths={[240, 480]} sizes="(max-width: 820px) 45vw, 170px" />
              ))}
            </a>
            <span class="meta">
              latest: <a href={`/photographs/${latestAlbum.id}/`}>{latestAlbum.data.title}</a>
            </span>
          </>
        ) : (
          <p class="empty">No albums yet.</p>
        )
      }
    </div>
  </section>
</Base>
